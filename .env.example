# MySQL (contenedor)
MYSQL_ROOT_PASSWORD=root_cambia_esto
MYSQL_DATABASE=planta
MYSQL_PORT=3306

# Usuario de solo lectura que usa el agente (creado en db/init/01_schema.sql)
MYSQL_READONLY_USER=agente_lectura
MYSQL_READONLY_PASSWORD=lectura_segura_123

# Ollama (paso 2). qwen2.5:7b sigue mejor las instrucciones en español que llama3.1:8b
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# Fragmentos que se le pasan al modelo
TOP_K=6

# Langfuse (opcional): tracing y evals. Llaves en Settings -> API Keys de tu proyecto.
# La URL debe ser la de la región donde creaste la cuenta (EU: cloud.langfuse.com, US: us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Seguridad de la API (/v1): una o varias llaves separadas por coma
API_KEYS=change-me

# Voz (paso 6). Whisper corre local; "small" entiende bien español. Opciones: base, small, medium
WHISPER_MODEL=small
# Azure AI Speech (texto -> voz). Recurso "Speech" en Azure, plan F0 gratuito. Sin llave, /v1/voz responde solo texto.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
